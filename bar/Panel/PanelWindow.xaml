<ui:FluentWindow x:Class="DshBar.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="dsh 控制台"
        Width="960" Height="640"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="188" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <!-- 颜色一律走主题刷 + DynamicResource：写死 #F3F3F3/White/#1A1D23 的话，
         切到 dark 就成了「深色 Fluent 外壳 + 纯白内容区」，spec §6/§7 不允许这种拼缝。
         DynamicResource 还让 Task 5 的主题开关当场生效，不用重建窗口。 -->
    <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="10,14,10,0">
        <TextBlock Text="dsh 控制台" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="4,0,0,12" />
        <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent"
                 SelectionChanged="OnNavChanged" />
      </StackPanel>
    </Border>
    <!-- 内容列必须是**有限高度**。这里原来把 Host 包在 ScrollViewer(VerticalScrollBarVisibility=Auto)
         里，而 ScrollViewer 给内容的竖向约束是无限高：概览页那个 `*` 行于是拿不到「视口高」，
         DataGrid 按行数长到 ~1150px 再由整页滚动兜着 —— 滚轮是滚得动的，但滚的是整页，
         表头跟着一起滚出视野（真窗口实测：滚轮后第一条变化的行在 y=19，正是表头那一带），
         排版成本也随行数线性上升。现在 Host 直接占 `*` 列的有限高度：
         表头固定、只有表体滚（实测变化从 y=85 才开始，表头那一条带一个像素没动）。
         页面契约随之明确 —— 需要整页滚动的页自己在页内放 ScrollViewer，外壳不再代劳；
         这条契约由 smoke_test.py 的 check_panel_real_scroll() 在真窗口上钉住。 -->
    <ContentControl x:Name="Host" Grid.Column="1" Margin="24,20,24,20" />
  </Grid>
</ui:FluentWindow>
